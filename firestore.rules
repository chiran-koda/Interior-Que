rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth != null && request.auth.token.email_verified == true;}
  function email(){return request.auth.token.email.lower();}
  function memberPath(company){return /databases/$(database)/documents/interiorQueCompanies/$(company)/members/$(request.auth.uid);}
  function member(company){return signed() && exists(memberPath(company)) && get(memberPath(company)).data.active == true;}
  function owner(company){return member(company) && get(memberPath(company)).data.role == 'owner';}
  function staff(company){return member(company) && get(memberPath(company)).data.role in ['owner','designer','supervisor'];}
  function access(company,project){return member(company) && (owner(company) || project in get(memberPath(company)).data.projectIds);}
  function text(value,max){return value is string && value.size() <= max;}
  function ids(value){return value is list && value.size() <= 25;}
  function projectExists(company,project){return existsAfter(/databases/$(database)/documents/interiorQueCompanies/$(company)/projects/$(project));}
  function assignedStaff(company,project){return staff(company) && access(company,project);}
  function validAssignee(company,data){return data.assigneeId == '' || (exists(/databases/$(database)/documents/interiorQueCompanies/$(company)/members/$(data.assigneeId)) && get(/databases/$(database)/documents/interiorQueCompanies/$(company)/members/$(data.assigneeId)).data.active == true && get(/databases/$(database)/documents/interiorQueCompanies/$(company)/members/$(data.assigneeId)).data.role in ['owner','designer','supervisor'] && (get(/databases/$(database)/documents/interiorQueCompanies/$(company)/members/$(data.assigneeId)).data.role == 'owner' || data.projectId in get(/databases/$(database)/documents/interiorQueCompanies/$(company)/members/$(data.assigneeId)).data.projectIds));}
  function visible(company,data){return access(company,data.projectId) && (staff(company) || data.clientVisible == true);}
  function date(value){return text(value,10) && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');}
  function amount(value){return value is number && value>=0 && value<=1000000000;}
  function reviewer(company,data){return exists(/databases/$(database)/documents/interiorQueCompanies/$(company)/members/$(data.reviewerId)) && get(/databases/$(database)/documents/interiorQueCompanies/$(company)/members/$(data.reviewerId)).data.active == true && (get(/databases/$(database)/documents/interiorQueCompanies/$(company)/members/$(data.reviewerId)).data.role == 'owner' || data.projectId in get(/databases/$(database)/documents/interiorQueCompanies/$(company)/members/$(data.reviewerId)).data.projectIds) && (get(/databases/$(database)/documents/interiorQueCompanies/$(company)/members/$(data.reviewerId)).data.role != 'client' || data.clientVisible == true);}
  function photo(company,project,id,shared){return id == '' || (text(id,100) && exists(/databases/$(database)/documents/interiorQueCompanies/$(company)/files/$(id)) && get(/databases/$(database)/documents/interiorQueCompanies/$(company)/files/$(id)).data.projectId == project && (!shared || get(/databases/$(database)/documents/interiorQueCompanies/$(company)/files/$(id)).data.clientVisible == true));}
  function reportPhotos(company,data){return !('photoIds' in data) || (data.photoIds is list && data.photoIds.size()<=4 && (data.photoIds.size()<1 || photo(company,data.projectId,data.photoIds[0],data.clientVisible)) && (data.photoIds.size()<2 || photo(company,data.projectId,data.photoIds[1],data.clientVisible)) && (data.photoIds.size()<3 || photo(company,data.projectId,data.photoIds[2],data.clientVisible)) && (data.photoIds.size()<4 || photo(company,data.projectId,data.photoIds[3],data.clientVisible)));}
  match /interiorQueCompanies/{company} {
   allow create: if signed() && request.resource.data.keys().hasOnly(['name','ownerId']) && request.resource.data.ownerId == request.auth.uid && text(request.resource.data.name,120) && request.resource.data.name.size()>0;
   allow read: if member(company);
   allow update: if owner(company) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) && text(request.resource.data.name,120);
   match /members/{user} {
    function validMember(data){return data.keys().hasOnly(['email','name','role','projectIds','active']) && text(data.email,254) && text(data.name,120) && data.role in ['owner','designer','supervisor','client'] && ids(data.projectIds) && data.active is bool;}
    function invite(){return get(/databases/$(database)/documents/interiorQueCompanies/$(company)/invites/$(email())).data;}
    allow read: if signed() && (request.auth.uid == user || staff(company));
    allow create: if signed() && validMember(request.resource.data) && request.resource.data.active == true && request.resource.data.email == email() && request.auth.uid == user && (
      (getAfter(/databases/$(database)/documents/interiorQueCompanies/$(company)).data.ownerId == user && request.resource.data.role == 'owner' && request.resource.data.projectIds.size() == 0)
      || (invite().status == 'Pending' && request.resource.data.role == invite().role && request.resource.data.projectIds == invite().projectIds && request.resource.data.name == invite().name)
    );
    allow update: if owner(company) && validMember(request.resource.data) && request.resource.data.email == resource.data.email && (user != request.auth.uid ? request.resource.data.role != 'owner' : request.resource.data.role == 'owner' && request.resource.data.active == true);
   }
   match /invites/{address} {
    function validInvite(data){return data.keys().hasOnly(['email','name','role','projectIds','status']) && data.email == address && text(data.name,120) && data.role in ['designer','supervisor','client'] && ids(data.projectIds) && data.status in ['Pending','Accepted'];}
    allow read: if owner(company) || (signed() && address == email());
    allow create: if owner(company) && validInvite(request.resource.data) && request.resource.data.status == 'Pending';
    allow update: if (owner(company) && validInvite(request.resource.data)) || (signed() && address == email() && resource.data.status == 'Pending' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'Accepted' && getAfter(memberPath(company)).data.email == email() && getAfter(memberPath(company)).data.role == resource.data.role && getAfter(memberPath(company)).data.projectIds == resource.data.projectIds);
   }
   match /projects/{project} {
    function validProject(data){return data.keys().hasOnly(['name','clientName','location','start','end','progress','status','brief','image']) && text(data.name,160) && text(data.clientName,120) && text(data.location,300) && text(data.brief,4000) && text(data.image,500) && data.start is string && data.end is string && data.end >= data.start && data.progress is number && data.progress>=0 && data.progress<=100 && data.status in ['Planning','In progress','Completed','Delayed'];}
    allow read: if access(company,project);
    allow create: if owner(company) && validProject(request.resource.data);
    allow update: if validProject(request.resource.data) && (owner(company) || (assignedStaff(company,project) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progress','status'])));
   }
   match /tasks/{task} {
    function validTask(data){return data.keys().hasOnly(['projectId','title','assigneeId','due','stage','priority','status']) && text(data.projectId,100) && text(data.title,300) && text(data.assigneeId,100) && text(data.due,10) && text(data.stage,80) && data.priority in ['Normal','High'] && data.status in ['To do','Doing','Done'];}
    allow read: if assignedStaff(company,resource.data.projectId);
    allow create: if validTask(request.resource.data) && validAssignee(company,request.resource.data) && assignedStaff(company,request.resource.data.projectId) && projectExists(company,request.resource.data.projectId);
    allow update: if validTask(request.resource.data) && request.resource.data.projectId == resource.data.projectId && assignedStaff(company,resource.data.projectId) && ((owner(company) && validAssignee(company,request.resource.data)) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
   }
   match /updates/{update} {
    function validUpdate(data){return data.keys().hasOnly(['projectId','authorId','authorName','date','room','summary','blocker','clientVisible','tomorrow','shortages','workers','photoIds']) && text(data.projectId,100) && text(data.authorName,120) && text(data.date,10) && text(data.room,120) && text(data.summary,4000) && text(data.blocker,1000) && data.clientVisible is bool && data.authorId == request.auth.uid && (!('tomorrow' in data) || text(data.tomorrow,2000)) && (!('shortages' in data) || text(data.shortages,1000)) && (!('workers' in data) || (data.workers is int && data.workers>=0 && data.workers<=10000)) && reportPhotos(company,data);}
    allow read: if visible(company,resource.data);
    allow create: if validUpdate(request.resource.data) && assignedStaff(company,request.resource.data.projectId) && projectExists(company,request.resource.data.projectId);
   }
   match /approvals/{approval} {
    function validApproval(data){return data.keys().hasOnly(['projectId','title','description','reviewerId','authorId','due','status','response','clientVisible']) && text(data.projectId,100) && text(data.title,300) && text(data.description,4000) && text(data.reviewerId,100) && text(data.authorId,100) && text(data.due,10) && data.status in ['Awaiting decision','Approved','Changes requested'] && text(data.response,2000) && data.clientVisible is bool;}
    allow read: if visible(company,resource.data);
    allow create: if validApproval(request.resource.data) && assignedStaff(company,request.resource.data.projectId) && projectExists(company,request.resource.data.projectId) && request.resource.data.authorId == request.auth.uid && request.resource.data.status == 'Awaiting decision' && request.resource.data.response == '' && exists(/databases/$(database)/documents/interiorQueCompanies/$(company)/members/$(request.resource.data.reviewerId)) && get(/databases/$(database)/documents/interiorQueCompanies/$(company)/members/$(request.resource.data.reviewerId)).data.active == true && (get(/databases/$(database)/documents/interiorQueCompanies/$(company)/members/$(request.resource.data.reviewerId)).data.role == 'owner' || request.resource.data.projectId in get(/databases/$(database)/documents/interiorQueCompanies/$(company)/members/$(request.resource.data.reviewerId)).data.projectIds) && (get(/databases/$(database)/documents/interiorQueCompanies/$(company)/members/$(request.resource.data.reviewerId)).data.role != 'client' || request.resource.data.clientVisible == true);
    allow update: if validApproval(request.resource.data) && visible(company,resource.data) && resource.data.reviewerId == request.auth.uid && resource.data.status == 'Awaiting decision' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','response']) && request.resource.data.status in ['Approved','Changes requested'] && (request.resource.data.status == 'Approved' || request.resource.data.response.size()>0);
   }
   match /files/{file} {
    allow read: if visible(company,resource.data);
    // R2 metadata is written only by the development photo Worker after verified upload.
    allow write: if false;
   }
   match /photoStorage/{usage} {
    allow read: if staff(company);
    allow write: if false;
   }
   match /photoUploads/{upload} {
    allow read, write: if false;
   }
   match /materials/{material} {
    function validMaterial(data){return data.keys().hasOnly(['projectId','name','quantity','unit','status','notes']) && text(data.projectId,100) && text(data.name,300) && data.quantity is number && data.quantity>0 && text(data.unit,40) && data.status in ['To order','Ordered','On site'] && text(data.notes,2000);}
    allow read: if assignedStaff(company,resource.data.projectId);
    allow create: if validMaterial(request.resource.data) && assignedStaff(company,request.resource.data.projectId) && projectExists(company,request.resource.data.projectId);
    allow update: if validMaterial(request.resource.data) && request.resource.data.projectId == resource.data.projectId && assignedStaff(company,resource.data.projectId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
   }
   match /projectBudgets/{budget} {
    function valid(data){return data.keys().hasOnly(['projectId','contractValue','costBudget','quotationRef']) && data.projectId == budget && projectExists(company,data.projectId) && amount(data.contractValue) && amount(data.costBudget) && text(data.quotationRef,500);}
    allow read: if owner(company);
    allow create, update: if owner(company) && valid(request.resource.data);
   }
   match /paymentSchedules/{milestone} {
    function valid(data){return data.keys().hasOnly(['projectId','title','amount','received','due','clientVisible']) && text(data.projectId,100) && projectExists(company,data.projectId) && text(data.title,300) && data.title.size()>0 && amount(data.amount) && data.amount>0 && amount(data.received) && date(data.due) && data.clientVisible is bool;}
    allow read: if owner(company) || (member(company) && !staff(company) && visible(company,resource.data));
    allow create: if owner(company) && valid(request.resource.data) && request.resource.data.received == 0;
    allow update: if owner(company) && valid(request.resource.data) && request.resource.data.projectId == resource.data.projectId;
   }
   match /selections/{selection} {
    function valid(data){return data.keys().hasOnly(['projectId','room','title','specification','photoId','authorId','reviewerId','due','status','response','clientVisible']) && text(data.projectId,100) && projectExists(company,data.projectId) && text(data.room,120) && data.room.size()>0 && text(data.title,300) && data.title.size()>0 && text(data.specification,4000) && text(data.authorId,100) && text(data.reviewerId,100) && date(data.due) && data.status in ['Awaiting decision','Approved','Changes requested'] && text(data.response,2000) && data.clientVisible is bool && photo(company,data.projectId,data.photoId,data.clientVisible);}
    allow read: if visible(company,resource.data);
    allow create: if assignedStaff(company,request.resource.data.projectId) && valid(request.resource.data) && reviewer(company,request.resource.data) && request.resource.data.authorId == request.auth.uid && request.resource.data.status == 'Awaiting decision' && request.resource.data.response == '';
    allow update: if visible(company,resource.data) && valid(request.resource.data) && resource.data.reviewerId == request.auth.uid && resource.data.status == 'Awaiting decision' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','response']) && request.resource.data.status in ['Approved','Changes requested'] && (request.resource.data.status == 'Approved' || request.resource.data.response.size()>0);
   }
   match /changeOrders/{change} {
    function valid(data){return data.keys().hasOnly(['projectId','title','description','amount','extraDays','authorId','reviewerId','due','status','response','clientVisible']) && text(data.projectId,100) && projectExists(company,data.projectId) && text(data.title,300) && data.title.size()>0 && text(data.description,4000) && amount(data.amount) && data.extraDays is int && data.extraDays>=0 && data.extraDays<=365 && text(data.authorId,100) && text(data.reviewerId,100) && date(data.due) && data.status in ['Awaiting decision','Approved','Changes requested'] && text(data.response,2000) && data.clientVisible is bool;}
    allow read: if owner(company) || (member(company) && !staff(company) && visible(company,resource.data));
    allow create: if owner(company) && valid(request.resource.data) && reviewer(company,request.resource.data) && get(/databases/$(database)/documents/interiorQueCompanies/$(company)/members/$(request.resource.data.reviewerId)).data.role in ['owner','client'] && request.resource.data.authorId == request.auth.uid && request.resource.data.status == 'Awaiting decision' && request.resource.data.response == '';
    allow update: if (owner(company) || visible(company,resource.data)) && valid(request.resource.data) && resource.data.reviewerId == request.auth.uid && resource.data.status == 'Awaiting decision' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','response']) && request.resource.data.status in ['Approved','Changes requested'] && (request.resource.data.status == 'Approved' || request.resource.data.response.size()>0);
   }
   match /drawingHeads/{head} {
    function valid(data){return data.keys().hasOnly(['projectId','groupId','nextVersion','currentId','clientVisible']) && head == data.projectId+'_'+data.groupId && text(data.groupId,1000) && data.nextVersion is int && data.nextVersion>0 && data.nextVersion<=10000 && text(data.currentId,100) && data.clientVisible is bool && projectExists(company,data.projectId);}
    function approved(data){return data.currentId!='' && getAfter(/databases/$(database)/documents/interiorQueCompanies/$(company)/drawings/$(data.currentId)).data.projectId==data.projectId && getAfter(/databases/$(database)/documents/interiorQueCompanies/$(company)/drawings/$(data.currentId)).data.groupId==data.groupId && getAfter(/databases/$(database)/documents/interiorQueCompanies/$(company)/drawings/$(data.currentId)).data.status=='Approved';}
    function superseded(){return resource.data.currentId=='' || (request.resource.data.currentId!=resource.data.currentId && getAfter(/databases/$(database)/documents/interiorQueCompanies/$(company)/drawings/$(resource.data.currentId)).data.status=='Superseded');}
    allow read: if (resource==null && staff(company)) || visible(company,resource.data);
    allow create: if assignedStaff(company,request.resource.data.projectId) && valid(request.resource.data) && request.resource.data.nextVersion==1 && request.resource.data.currentId=='' && request.resource.data.clientVisible==false;
    allow update: if assignedStaff(company,resource.data.projectId) && valid(request.resource.data) && request.resource.data.projectId==resource.data.projectId && request.resource.data.groupId==resource.data.groupId && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextVersion']) && request.resource.data.nextVersion==resource.data.nextVersion+1) || (owner(company) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentId','clientVisible']) && approved(request.resource.data) && superseded()));
   }
   match /drawings/{drawing} {
    function head(data){return getAfter(/databases/$(database)/documents/interiorQueCompanies/$(company)/drawingHeads/$(data.projectId+'_'+data.groupId)).data;}
    function next(data){let path=/databases/$(database)/documents/interiorQueCompanies/$(company)/drawingHeads/$(data.projectId+'_'+data.groupId);return data.version==(exists(path)?get(path).data.nextVersion+1:1);}
    function valid(data){return data.keys().hasOnly(['projectId','groupId','title','room','url','version','authorId','date','status','clientVisible']) && text(data.projectId,100) && projectExists(company,data.projectId) && text(data.groupId,1000) && text(data.title,300) && data.title.size()>0 && text(data.room,120) && data.room.size()>0 && text(data.url,2000) && data.url.matches('^https://[^@]+$') && data.version is int && data.version>0 && text(data.authorId,100) && date(data.date) && data.status in ['Draft','Approved','Superseded'] && data.clientVisible is bool;}
    allow read: if visible(company,resource.data);
    allow create: if assignedStaff(company,request.resource.data.projectId) && valid(request.resource.data) && request.resource.data.authorId==request.auth.uid && request.resource.data.status=='Draft' && request.resource.data.clientVisible==false && head(request.resource.data).nextVersion==request.resource.data.version && next(request.resource.data);
    allow update: if owner(company) && valid(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','clientVisible']) && ((resource.data.status=='Draft' && request.resource.data.status=='Approved' && head(request.resource.data).currentId==drawing && head(request.resource.data).clientVisible==request.resource.data.clientVisible) || (resource.data.status=='Approved' && request.resource.data.status=='Superseded' && head(request.resource.data).currentId!=drawing && request.resource.data.clientVisible==resource.data.clientVisible));
   }
   match /purchaseOrders/{order} {
    function valid(data){return data.keys().hasOnly(['projectId','materialId','title','supplier','quantity','receivedQuantity','unit','unitRate','due','notes','authorId']) && text(data.projectId,100) && projectExists(company,data.projectId) && text(data.materialId,100) && (data.materialId=='' || get(/databases/$(database)/documents/interiorQueCompanies/$(company)/materials/$(data.materialId)).data.projectId==data.projectId) && text(data.title,300) && data.title.size()>0 && text(data.supplier,300) && data.supplier.size()>0 && data.quantity is number && data.quantity>0 && data.quantity<=1000000 && data.receivedQuantity is number && data.receivedQuantity>=0 && data.receivedQuantity<=data.quantity && text(data.unit,40) && data.unit.size()>0 && amount(data.unitRate) && date(data.due) && text(data.notes,2000) && text(data.authorId,100);}
    allow read: if (resource==null && staff(company)) || assignedStaff(company,resource.data.projectId);
    allow create: if assignedStaff(company,request.resource.data.projectId) && get(memberPath(company)).data.role in ['owner','designer'] && valid(request.resource.data) && request.resource.data.authorId==request.auth.uid && request.resource.data.receivedQuantity==0;
    allow update: if assignedStaff(company,resource.data.projectId) && valid(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receivedQuantity']) && (owner(company) || request.resource.data.receivedQuantity>=resource.data.receivedQuantity);
   }
   match /snags/{snag} {
    function valid(data){return data.keys().hasOnly(['projectId','title','room','description','photoId','authorId','assigneeId','due','status','resolution','completionPhotoId','clientVisible']) && text(data.projectId,100) && projectExists(company,data.projectId) && text(data.title,300) && data.title.size()>0 && text(data.room,120) && data.room.size()>0 && text(data.description,2000) && text(data.authorId,100) && text(data.assigneeId,100) && date(data.due) && data.status in ['Open','Ready for check','Resolved'] && text(data.resolution,2000) && data.clientVisible is bool && photo(company,data.projectId,data.photoId,data.clientVisible) && photo(company,data.projectId,data.completionPhotoId,data.clientVisible);}
    allow read: if visible(company,resource.data);
    allow create: if access(company,request.resource.data.projectId) && valid(request.resource.data) && request.resource.data.authorId==request.auth.uid && request.resource.data.status=='Open' && request.resource.data.resolution=='' && request.resource.data.completionPhotoId=='' && (staff(company) ? validAssignee(company,request.resource.data) : request.resource.data.assigneeId=='' && request.resource.data.clientVisible==true);
    allow update: if visible(company,resource.data) && valid(request.resource.data) && request.resource.data.projectId==resource.data.projectId && request.resource.data.authorId==resource.data.authorId && ((resource.data.status=='Open' && request.resource.data.status=='Open' && (owner(company) || resource.data.authorId==request.auth.uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(owner(company) ? ['title','room','description','photoId','assigneeId','due','clientVisible'] : ['title','room','description','photoId','due']) && validAssignee(company,request.resource.data)) || (resource.data.status=='Open' && request.resource.data.status=='Ready for check' && assignedStaff(company,resource.data.projectId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolution','completionPhotoId']) && request.resource.data.resolution.size()>0) || (resource.data.status=='Ready for check' && request.resource.data.status=='Resolved' && (owner(company) || (!staff(company) && resource.data.authorId==request.auth.uid)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])));
   }
   match /handovers/{handover} {
    function valid(data){return data.keys().hasOnly(['projectId','checks','date','notes','completed','clientVisible']) && data.projectId==handover && projectExists(company,data.projectId) && data.checks is list && data.checks.size()==5 && data.checks[0] is bool && data.checks[1] is bool && data.checks[2] is bool && data.checks[3] is bool && data.checks[4] is bool && date(data.date) && text(data.notes,2000) && data.completed is bool && data.clientVisible==true && (!data.completed || (data.checks[0] && data.checks[1] && data.checks[2] && data.checks[3] && data.checks[4]));}
    allow read: if visible(company,resource.data);
    allow create: if owner(company) && valid(request.resource.data);
    allow update: if owner(company) && valid(request.resource.data) && resource.data.completed==false;
   }
   match /{journal}/{payment} {
    function validJournal(){return journal in ['expenses','receipts'];}
    function validCategory(data){return !('categoryId' in data) || (text(data.categoryId,100) && (data.categoryId in (journal == 'expenses' ? ['exp-materials','exp-labour','exp-salaries','exp-transport','exp-electrical','exp-food','exp-other'] : ['inc-client','inc-capital','inc-other']) || (exists(/databases/$(database)/documents/interiorQueCompanies/$(company)/moneyCategories/$(data.categoryId)) && get(/databases/$(database)/documents/interiorQueCompanies/$(company)/moneyCategories/$(data.categoryId)).data.type == data.type)));}
    function validPayment(data){return data.keys().hasOnly(['projectId','description','amount','type','date','categoryId','mode','milestoneId']) && text(data.projectId,100) && projectExists(company,data.projectId) && text(data.description,500) && data.description.size()>0 && data.amount is number && data.amount>0 && data.amount<=1000000000 && data.type == (journal == 'expenses' ? 'Spent' : 'Received') && text(data.date,10) && data.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$') && (!('mode' in data) || data.mode in ['Cash','Bank transfer','UPI','Cheque','Other','Unspecified']) && validCategory(data) && (!('milestoneId' in data) || (journal == 'receipts' && text(data.milestoneId,100) && get(/databases/$(database)/documents/interiorQueCompanies/$(company)/paymentSchedules/$(data.milestoneId)).data.projectId == data.projectId));}
    allow read: if validJournal() && owner(company);
    allow create: if validJournal() && owner(company) && validPayment(request.resource.data);
    allow update: if validJournal() && owner(company) && request.resource.data.projectId == resource.data.projectId && request.resource.data.type == resource.data.type && validPayment(request.resource.data);
   }
   match /moneyCategories/{category} {
    function validCategory(data){return data.keys().hasOnly(['name','type','color','active']) && text(data.name,60) && data.name.size()>0 && data.type in ['Received','Spent'] && data.color is string && data.color.matches('^#[0-9a-fA-F]{6}$') && data.active is bool;}
    allow read: if owner(company);
    allow create: if owner(company) && validCategory(request.resource.data);
    allow update: if owner(company) && validCategory(request.resource.data) && request.resource.data.type == resource.data.type;
   }
   match /cashOpenings/{opening} {
    function validOpening(data){return data.keys().hasOnly(['projectId','amount','date']) && data.projectId == opening && projectExists(company,data.projectId) && data.amount is number && data.amount>=0 && data.amount<=1000000000 && text(data.date,10) && data.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');}
    allow read: if owner(company);
    allow create, update: if owner(company) && validOpening(request.resource.data);
   }
   match /balanceOpenings/{opening} {
    function validOpening(data){return data.keys().hasOnly(['projectId','amount','date']) && data.projectId == opening && projectExists(company,data.projectId) && data.amount is number && data.amount>=0 && data.amount<=1000000000 && text(data.date,10) && data.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');}
    allow read: if owner(company);
    allow create, update: if owner(company) && validOpening(request.resource.data);
   }
  }
 }
}
