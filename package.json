{
  "name": "interior-que",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run src worker",
    "check:worker": "tsc -p worker/tsconfig.json",
    "dev:worker": "wrangler dev --config worker/wrangler.jsonc",
    "build:worker": "wrangler deploy --dry-run --config worker/wrangler.jsonc --outdir ../worker-build",
    "preview": "vite preview --host 127.0.0.1",
    "test:rules": "firebase emulators:exec --only firestore --project demo-interior-que \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "firebase": "^12.19.0",
    "idb": "^8.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.33.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18"
  }
}
