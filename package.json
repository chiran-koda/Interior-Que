    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.33.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
